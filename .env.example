# Copiar a .env.local y completar. Nunca subir valores reales.
NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Uso restringido (Super Admin / webhooks).
# Requerida: el formulario público la usa para enviar solicitudes (src/lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Lectura de recibos con IA (opcional; sin esta llave el botón no aparece). Solo servidor.
ANTHROPIC_API_KEY=
# Modelo para leer recibos (opcional, por defecto claude-haiku-5-5).
RECEIPT_AI_MODEL=
# Captcha Cloudflare Turnstile en el formulario público de solicitudes. OBLIGATORIO en producción: sin TURNSTILE_SECRET_KEY el formulario rechaza todo (solo en desarrollo se omite).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sal opcional para el hash de IP del límite por visitante del formulario público (cualquier texto largo y aleatorio).
IP_HASH_SALT=
