# Copiar a .env.local y completar. Nunca subir valores reales.
NEXT_PUBLIC_APP_URL=http://localhost:3200
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Uso restringido (Super Admin / webhooks).
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Lectura de recibos con IA (opcional; sin esta llave el botón no aparece). Solo servidor.
ANTHROPIC_API_KEY=
# Modelo para leer recibos (opcional, por defecto claude-haiku-5-5).
RECEIPT_AI_MODEL=
